common --registry=https://raw.githubusercontent.com/securely1g/sonic-bazel-registry/main
common --registry=https://bcr.bazel.build
common --lockfile_mode=update
build --incompatible_strict_action_env
build --enable_platform_specific_config
build --platforms=@sonic_build_infra//platforms:x86_64_trixie
build --compilation_mode=opt
test --test_output=errors
build:xfmr --//:include_test_models
build:xfmr --@io_bazel_rules_go//go/config:tags=xfmrtest
