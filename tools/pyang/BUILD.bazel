load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "import_yang",
    srcs = ["import_yang.py"],
    deps = [
        "@mgmt_pip//pyang",
        "@mgmt_pip//setuptools",
    ],
)

py_library(
    name = "plugins",
    srcs = ["yangtools.py"] + glob(["pyang_plugins/*.py"]),
    imports = ["."],
    deps = [
        "@mgmt_pip//pyang",
        "@mgmt_pip//setuptools",
    ],
)

copy_file(
    name = "tree_main",
    src = "tree",
    out = "tree_main.py",
)

py_binary(
    name = "tree_tool",
    srcs = [":tree_main"],
    main = "tree_main.py",
    deps = [":plugins"],
)

copy_file(
    name = "lint_main",
    src = "lint",
    out = "lint_main.py",
)

py_binary(
    name = "lint_tool",
    srcs = [":lint_main"],
    main = "lint_main.py",
    deps = [
        ":plugins",
        "@oc_pyang//:openconfig_linter",
    ],
)

py_test(
    name = "discovery_test",
    srcs = ["discovery_test.py"],
    args = [
        "$(location :tree)",
        "$(location //models/yang:prepared_models)",
    ],
    data = [
        "tree",
        "//models/yang:prepared_models",
    ],
    deps = [":plugins"],
)
